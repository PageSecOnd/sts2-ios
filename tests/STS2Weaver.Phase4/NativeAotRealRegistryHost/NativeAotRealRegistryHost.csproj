<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticModInputDir Condition="'$(StaticModInputDir)' == ''">$(MSBuildProjectDirectory)/../../../ios-export/.work/phase4/real-baselib-input</StaticModInputDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(StaticModInputDir)/sts2.dll" />
    <Reference Include="BaseLib" HintPath="$(StaticModInputDir)/deps/BaseLib.dll" />
    <Reference Include="GodotSharp" HintPath="$(StaticModInputDir)/deps/GodotSharp.dll" />
    <Reference Include="STS2StaticModRegistry" HintPath="$(StaticModInputDir)/deps/STS2StaticModRegistry.dll" />
    <TrimmerRootDescriptor Include="$(StaticModInputDir)/static-mod-roots.xml" />
  </ItemGroup>
</Project>

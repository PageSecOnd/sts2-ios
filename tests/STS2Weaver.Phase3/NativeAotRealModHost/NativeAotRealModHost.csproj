<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StaticModInputDir Condition="'$(StaticModInputDir)' == ''">$(MSBuildProjectDirectory)/../../../ios-export/.work/phase3/nativeaot-input</StaticModInputDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(StaticModInputDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(StaticModInputDir)/BaseLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(StaticModInputDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>

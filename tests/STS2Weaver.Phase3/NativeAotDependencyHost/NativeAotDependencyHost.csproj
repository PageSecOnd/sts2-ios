<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticModInputDir Condition="'$(StaticModInputDir)' == ''">$(MSBuildProjectDirectory)/../../../ios-export/.work/phase3/matrix-input</StaticModInputDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FixtureTarget" HintPath="$(StaticModInputDir)/FixtureTarget.dll" />
    <Reference Include="MatrixDependentMod" HintPath="$(StaticModInputDir)/MatrixDependentMod.dll" />
    <Reference Include="MatrixDependency" HintPath="$(StaticModInputDir)/MatrixDependency.dll" />
  </ItemGroup>
</Project>
